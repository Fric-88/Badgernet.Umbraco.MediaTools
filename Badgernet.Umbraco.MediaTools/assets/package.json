{
  "name": "assets",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "buildMini": "tsc && vite build --minify 'eslint'",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "generateApi": "openapi-ts --input http://localhost:2812/umbraco/swagger/mediatools/swagger.json --output src/api",
    "buildWasm": "emcc src/elements/imageEditor/wasm/manipulate.cpp -O3 -s WASM=1 -s MODULARIZE=1 -s EXPORT_ES6=1 -s ENVIRONMENT=web -s EXPORTED_FUNCTIONS='[_manipulateImageData,_malloc,_free]' -s EXPORTED_RUNTIME_METHODS='[ccall,cwrap,HEAPU8]' -o src/elements/imageEditor/wasm/manipulate.js"
  },
  "dependencies": {
    "@hey-api/openapi-ts": "^0.81.1",
    "@umbraco-cms/backoffice": "^16.3.4",
    "node": "^23.11.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.81.1",
    "eslint": "^9.8.0",
    "lit": "^3.2.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
